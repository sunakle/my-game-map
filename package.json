{
  "name": "my-game-map",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "example": "node --experimental-strip-types scripts/generate-example.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "package:win": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "idb": "^8.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "main": "desktop/main.cjs",
  "author": "sunakle",
  "description": "Мастерская карт и фигур",
  "build": {
    "appId": "studio.sunakle.mapworkshop",
    "productName": "Мастерская карт",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": "portable",
      "icon": "desktop/map-studio.ico",
      "signExecutable": false,
      "artifactName": "MapStudio-0.2.0-Windows-x64.exe"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
